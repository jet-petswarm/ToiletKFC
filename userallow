-- ตรวจสอบ Whitelist และโหลด ToiletKFC (แบบตัดช่องว่างอัตโนมัติ)
local MAIN_URL = "https://raw.githubusercontent.com/jet-petswarm/ToiletKFC/refs/heads/main/alliance"
local player = game.Players.LocalPlayer

-- รายชื่อผู้เล่นที่ได้รับอนุญาต
local ALLOWED_PLAYERS = {
    "ripgodinder",
    "kaitun_jet03alliance",
    "ชื่อผู้เล่นคนที่3",
    "ชื่อผู้เล่นคนที่4",
    "ชื่อผู้เล่นคนที่5",
    "ชื่อผู้เล่นคนที่6",
    "ชื่อผู้เล่นคนที่7",
    "ชื่อผู้เล่นคนที่8",
    "ชื่อผู้เล่นคนที่9",
    "ชื่อผู้เล่นคนที่10"
}

-- ฟังก์ชันสำหรับตัดช่องว่างส่วนเกินออก
local function cleanStr(str)
    return tostring(str):match("^%s*(.-)%s*$")
end

-- เช็กชื่อ (เทียบแบบตัดช่องว่างทิ้งทั้งสองฝั่ง)
local isAllowed = false
local currentName = cleanStr(player.Name)

for _, username in ipairs(ALLOWED_PLAYERS) do
    if currentName == cleanStr(username) then
        isAllowed = true
        break
    end
end

if not isAllowed then
    player:Kick("You must ask permission from Head Jet first.")
    return
end

-- ถ้าผ่านการตรวจสอบ จะโหลดและรันสคริปต์จาก ToiletKFC ทันที
local ls = loadstring or load
local ok, src = pcall(function() return game:HttpGet(MAIN_URL) end)
if ok and type(src) == "string" then
    local f, err = ls(src, "ToiletKFC")
    if f then
        f()
    else
        warn("[JET HUB] Main script compile error: " .. tostring(err))
    end
else
    warn("[JET HUB] Failed to download ToiletKFC script.")
end
