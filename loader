-- JET HUB LOADER
local ALLOW_URL = "https://raw.githubusercontent.com/jet-petswarm/ToiletKFC/refs/heads/main/userallow"

local ls = loadstring or load
if type(ls) ~= "function" then warn("[JET HUB] Executor not supported") return end

local ok, src = pcall(function() return game:HttpGet(ALLOW_URL) end)
if not ok or type(src) ~= "string" or #src < 10 then
    warn("[JET HUB] Failed to load loader file.")
    return
end

local f, err = ls(src, "JetHubLoader")
if not f then warn("[JET HUB] Compile Error: " + tostring(err)) return end

local okRun, runErr = pcall(f)
if not okRun then warn("[JET HUB] Runtime Error: " + tostring(runErr)) end
